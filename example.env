HOME_INTERNAL_KEY=change-me-at-least-16-bytes
HOME_DATABASE_URL=postgres://home:secret@127.0.0.1:5432/pokemonhome?sslmode=disable
HOME_HTTP_ADDR=:20180
HOME_LEGALITY_URL=http://127.0.0.1:20170
HOME_LEGALITY_KEY=
HOME_GL_URL=http://127.0.0.1:20160
HOME_GL_KEY=
HOME_NX_URL=http://127.0.0.1:20070
HOME_NX_KEY=
# comma list of nintendo.ai application ids; empty accepts any proven id token (until a capture names HOME's)
HOME_APPLICATION_IDS=
HOME_BOXES=200
HOME_BOX_SLOTS=30
HOME_WONDER_DELAY=5m
HOME_WONDER_SLOTS=3
HOME_ROOM_MAX=20
HOME_ROOM_TTL=24h
# set to record every unmatched request (capture mode), e.g. /capture
HOME_CAPTURE_DIR=
# console-facing TLS listener (OpenPak-CA leaf + CA in one PEM); off by default
HOME_TLS_CERT=
HOME_TLS_KEY=
HOME_TLS_ADDR=:20181
